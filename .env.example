# ─────────────────────────────────────────────────────────────
# HAMA BEADS — variáveis de ambiente
# Copie para .env (local) e cadastre na Vercel (Settings → Environment Variables).
# NUNCA commite valores reais.
# ─────────────────────────────────────────────────────────────

# Banco (PostgreSQL / Neon). Pooled para a aplicação, direta para migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# URL pública (sem barra final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Segredo para hashes de IP/assinaturas — gere com: openssl rand -hex 32
AUTH_SECRET=

# Primeiro administrador (bootstrap). A senha NUNCA fica no código:
#   npm run admin:hash -- "sua-senha-forte-com-12+"
# e cole a saída (formato b64:...) abaixo. No primeiro login o usuário OWNER é criado no banco.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# BravoPay (https://bravopay.club/docs)
BRAVOPAY_API_KEY=            # bp_live_...  (Authorization: Bearer)
BRAVOPAY_WEBHOOK_SECRET=     # segredo do webhook (assinatura HMAC-SHA256)
BRAVOPAY_PRODUCT_ID=         # opcional — atribuição UTMify
BRAVOPAY_BASE_URL=           # opcional — padrão https://bravopay.club/api/v1
BRAVOPAY_MODE=               # "mock" = PIX fictício para testes (bloqueado em produção)

# Jobs (Vercel Cron + GitHub Actions): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# E-mails transacionais (Resend): confirmação de compra, lembrete de PIX (10 min), aviso de envio
RESEND_API_KEY=              # re_...
EMAIL_FROM=                  # "Hama Beads <pedidos@hamabeads.site>" (domínio verificado na Resend)
EMAIL_REPLY_TO=              # opcional
EMAIL_PROVIDER=              # "console" = só registra no log (desenvolvimento)

# Vercel Blob (upload de imagens, vídeos e arquivos digitais pelo admin)
BLOB_READ_WRITE_TOKEN=

# Meta Pixel / Conversions API
NEXT_PUBLIC_META_PIXEL_ID=   # opcional: também configurável no admin
META_ACCESS_TOKEN=           # token da Conversions API (somente servidor)
META_TEST_EVENT_CODE=        # opcional: código de teste do Gerenciador de Eventos
META_GRAPH_VERSION=          # opcional: padrão v21.0

# Google Analytics 4
NEXT_PUBLIC_GA_ID=           # opcional: também configurável no admin (G-XXXXXXX)

# Otimização de imagens da Vercel (opt-in: consome cota do plano)
IMAGE_OPTIMIZATION=
