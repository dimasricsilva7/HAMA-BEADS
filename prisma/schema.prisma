// HAMA BEADS — schema PostgreSQL
// Valores monetários sempre em centavos (Int). Nenhum preço/composição fica no código:
// tudo é editável no admin e os pedidos guardam snapshot do que foi vendido.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Admin / auth / auditoria ─────────────────────────

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         AdminRole      @default(ADMIN)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// Tentativas de login (brute force) — persistente entre instâncias serverless.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Alterações administrativas: quem, o quê, valor anterior e novo.
model AuditLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  entityId  String?
  summary   String?
  before    Json?
  after     Json?
  details   Json?
  ipHash    String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ───────────────────────── Catálogo ─────────────────────────

enum ProductCategory {
  KIT
  PEGBOARD
  TWEEZERS
  DIGITAL_MODELS
  ACCESSORY
  TOOL
  OTHER
}

enum FulfillmentType {
  PHYSICAL
  DIGITAL
  HYBRID
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
}

model Product {
  id                  String          @id @default(cuid())
  slug                String          @unique
  sku                 String          @unique
  name                String
  category            ProductCategory @default(KIT)
  fulfillment         FulfillmentType @default(PHYSICAL)
  shortDescription    String?
  description         String?
  priceCents          Int
  compareAtPriceCents Int?
  // Promoção real com início/fim (sem contagem regressiva falsa)
  promoPriceCents     Int?
  promoStartsAt       DateTime?
  promoEndsAt         DateTime?
  promoLabel          String?
  // Números-chave exibidos na LP (null = não exibir; nunca inventar)
  beadCount           Int?
  colorCount          Int?
  pegboardCount       Int?
  modelCount          Int?
  /// Composição editável: [{ id, type, label, quantity, detail, imageUrl, isBonus }]
  components          Json            @default("[]")
  /// Especificações livres: [{ label, value }] (ex.: tamanho das peças, dimensões do pegboard)
  specs               Json            @default("[]")
  imageUrl            String?
  /// Galeria: [{ url, alt }]
  gallery             Json            @default("[]")
  videoUrl            String?
  badge               String?
  featured            Boolean         @default(false)
  active              Boolean         @default(true)
  sortOrder           Int             @default(0)
  stockStatus         StockStatus     @default(IN_STOCK)
  stockQuantity       Int?
  /// Produtos sugeridos no "Complete seu kit" quando este está no carrinho
  crossSellIds        Json            @default("[]")
  /// Produtos já inclusos neste (não oferecer como cross-sell/bump/upsell)
  includedProductIds  Json            @default("[]")
  // Produto digital
  digitalDeliveryNote String?
  /// URL privada do conteúdo — nunca enviada ao navegador; acesso via /api/downloads/[token]
  digitalFileUrl      String?
  digitalMaxDownloads Int?
  digitalValidityDays Int?
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  orderItems          OrderItem[]
  orderBumps          OrderBump[]
  upsells             Upsell[]
  reviews             Review[]
  priceHistory        PriceHistory[]

  @@index([active, sortOrder])
}

/// Histórico de preços (análise de preço × conversão). Pedidos já guardam o preço aplicado.
model PriceHistory {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPriceCents Int?
  newPriceCents Int
  adminId       String?
  createdAt     DateTime @default(now())

  @@index([productId, createdAt])
}

// ───────────────────────── Clientes / pedidos ─────────────────────────

model Customer {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  phone            String
  cpf              String?
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

enum OrderStatus {
  PENDING
  PIX_GENERATED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGEBACK
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  CHARGEBACK
  FAILED
}

enum OrderSource {
  STOREFRONT
  UPSELL
}

model Order {
  id                String         @id @default(cuid())
  seq               Int            @unique @default(autoincrement())
  orderNumber       String?        @unique
  source            OrderSource    @default(STOREFRONT)
  parentOrderId     String?
  parentOrder       Order?         @relation("OrderUpsells", fields: [parentOrderId], references: [id], onDelete: SetNull)
  upsellOrders      Order[]        @relation("OrderUpsells")
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Snapshot do cliente e do endereço no momento da compra
  customerSnapshot  Json
  shippingAddress   Json?
  status            OrderStatus    @default(PENDING)
  paymentStatus     PaymentStatus  @default(PENDING)
  trackingCode      String?
  subtotalCents     Int
  discountCents     Int            @default(0)
  shippingCents     Int            @default(0)
  totalCents        Int
  couponId          String?
  coupon            Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode        String?
  paymentMethod     String         @default("PIX")
  paymentProvider   String         @default("bravopay")
  transactionId     String?        @unique
  externalReference String?        @unique
  pixCopyPaste      String?
  pixExpiresAt      DateTime?
  paymentError      String?
  paidAmountCents   Int?
  feeCents          Int?
  netCents          Int?
  /// Chave de idempotência gerada no navegador: impede pedido duplicado em duplo clique
  checkoutToken     String?        @unique
  /// Token secreto para acessar o pedido por link
  accessToken       String         @unique
  metaEventId       String?
  /// Consentimento de cookies de marketing no momento da compra (Pixel/CAPI)
  adsConsent        Boolean        @default(false)
  /// Variantes de teste A/B no momento da compra: { experimentKey: variantKey }
  experiments       Json?
  // Atribuição — last touch nos campos principais + first touch
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?
  firstTouchSource  String?
  firstTouchMedium  String?
  firstTouchCampaign String?
  firstTouchContent String?
  firstTouchTerm    String?
  fbclid            String?
  gclid             String?
  ttclid            String?
  fbp               String?
  fbc               String?
  landingPage       String?
  referrer          String?
  sessionId         String?
  visitorId         String?
  device            String?
  userAgent         String?
  ipHash            String?
  channel           String?
  // Ciclo de vida
  paidAt            DateTime?
  expiredAt         DateTime?
  cancelledAt       DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  lastCheckedAt     DateTime?
  purchaseTrackedAt DateTime?
  couponCountedAt   DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  items             OrderItem[]
  payments          Payment[]
  paymentEvents     PaymentEvent[]
  upsellEvents      UpsellEvent[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([paidAt])
}

enum OrderItemKind {
  PRODUCT
  ORDER_BUMP
  UPSELL
  CROSS_SELL
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                OrderItemKind   @default(PRODUCT)
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot — alterações futuras no produto não mudam o histórico
  productName         String
  sku                 String
  category            ProductCategory
  fulfillment         FulfillmentType
  quantity            Int
  unitPriceCents      Int
  listPriceCents      Int
  totalPriceCents     Int
  composition         Json?
  orderBumpId         String?
  upsellId            String?
  digitalAccess       DigitalAccess[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String        @default("bravopay")
  transactionId String        @unique
  method        String        @default("PIX")
  status        PaymentStatus @default(PENDING)
  amountCents   Int
  feeCents      Int?
  netCents      Int?
  paidAt        DateTime?
  metadata      Json?
  tracking      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([orderId])
}

/// Linha do tempo do pedido/pagamento (requisições, respostas, webhooks, polling, mudanças de status).
model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  status    String?
  message   String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Registro de webhooks — eventId único garante idempotência.
model WebhookEvent {
  id             String        @id @default(cuid())
  provider       String        @default("bravopay")
  eventId        String        @unique
  eventType      String
  status         WebhookStatus @default(RECEIVED)
  transactionId  String?
  orderId        String?
  previousStatus String?
  newStatus      String?
  result         String?
  payloadHash    String
  payload        Json
  error          String?
  attempts       Int           @default(1)
  receivedAt     DateTime      @default(now())
  processedAt    DateTime?

  @@index([receivedAt])
  @@index([transactionId])
}

/// Acesso seguro a conteúdo digital comprado.
model DigitalAccess {
  id            String    @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  token         String    @unique
  downloads     Int       @default(0)
  maxDownloads  Int?
  expiresAt     DateTime?
  lastAccessAt  DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([orderItemId])
}

// ───────────────────────── Ofertas ─────────────────────────

model OrderBump {
  id                String   @id @default(cuid())
  name              String
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  benefit           String?
  imageUrl          String?
  /// null = usa o preço atual do produto
  priceCents        Int?
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  /// Mostrar somente quando o carrinho contiver algum destes produtos (vazio = sempre)
  triggerProductIds Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Upsell {
  id                String        @id @default(cuid())
  name              String
  productId         String
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  headline          String
  title             String
  description       String?
  imageUrl          String?
  priceCents        Int?
  /// Posição na sequência (Upsell 1 → 2 → 3)
  sortOrder         Int           @default(0)
  active            Boolean       @default(true)
  /// Oferecer somente se o pedido contiver algum destes produtos (vazio = sempre)
  triggerProductIds Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  events            UpsellEvent[]
}

enum UpsellAction {
  VIEW
  ACCEPT
  REJECT
}

model UpsellEvent {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  upsellId     String
  upsell       Upsell       @relation(fields: [upsellId], references: [id], onDelete: Cascade)
  action       UpsellAction
  childOrderId String?
  priceCents   Int?
  createdAt    DateTime     @default(now())

  @@unique([orderId, upsellId, action])
  @@index([upsellId, createdAt])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType @default(PERCENT)
  /// PERCENT: 1–100 · FIXED: centavos
  value            Int
  minSubtotalCents Int?
  startsAt         DateTime?
  endsAt           DateTime?
  maxUses          Int?
  usedCount        Int        @default(0)
  /// Produtos aplicáveis (vazio = todos)
  productIds       Json       @default("[]")
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  orders           Order[]
}

// ───────────────────────── Analytics ─────────────────────────

model AnalyticsSession {
  id          String           @id
  visitorId   String
  customerId  String?
  firstSeenAt DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())
  landingPage String?
  exitPage    String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  fbclid      String?
  gclid       String?
  ttclid      String?
  channel     String?
  device      String?
  browser     String?
  os          String?
  /// Variantes A/B atribuídas: { experimentKey: variantKey }
  experiments Json?
  pageViews   Int              @default(0)
  events      AnalyticsEvent[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

/// Evento próprio. Origem (UTM/click IDs), dispositivo, navegador e SO vêm da sessão
/// (normalização) e também são copiados aqui para relatórios rápidos.
model AnalyticsEvent {
  id          String           @id @default(cuid())
  sessionId   String
  session     AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId   String
  customerId  String?
  orderId     String?
  name        String
  path        String?
  productId   String?
  element     String?
  valueCents  Int?
  props       Json?
  device      String?
  utmSource   String?
  utmCampaign String?
  createdAt   DateTime         @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([sessionId])
  @@index([productId, name])
}

/// Custo de mídia (manual ou importado) → CPA, CAC, ROAS.
model AdSpend {
  id         String   @id @default(cuid())
  date       DateTime @db.Date
  source     String
  campaign   String?
  adset      String?
  ad         String?
  spendCents Int
  createdAt  DateTime @default(now())

  @@index([date])
}

/// Teste A/B. variants: [{ key, weight, label, value }]
model Experiment {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  target    String
  active    Boolean  @default(false)
  variants  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── CMS ─────────────────────────

/// Bloco da landing page. `config` guarda os campos específicos de cada seção.
model LandingSection {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  title     String?
  subtitle  String?
  body      String?
  imageUrl  String?
  videoUrl  String?
  ctaLabel  String?
  ctaTarget String?
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  category    String
  imageUrl    String
  alt         String   @default("")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  /// Também aparece em "O que você criaria?"
  inspiration Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Somente avaliações reais, cadastradas e aprovadas pelo admin.
model Review {
  id         String    @id @default(cuid())
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name       String
  text       String
  rating     Int
  photoUrl   String?
  videoUrl   String?
  reviewedAt DateTime?
  approved   Boolean   @default(false)
  featured   Boolean   @default(false)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Modelos de mensagem para recuperação manual (WhatsApp/e-mail). Nada é enviado automaticamente.
model MessageTemplate {
  id        String   @id @default(cuid())
  channel   String
  name      String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Trava simples para jobs (evita duas execuções simultâneas).
model JobLock {
  name      String   @id
  lockedAt  DateTime
  expiresAt DateTime
}
